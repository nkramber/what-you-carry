<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit (D-66). The runner and the test SDK are the packages that `dotnet test` needs to run xUnit. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../WhatYouCarry.Assets/WhatYouCarry.Assets.csproj" />
    <ProjectReference Include="../WhatYouCarry.Core/WhatYouCarry.Core.csproj" />
    <!-- The Game project, for the pure input and render logic of PR-12. A test calls no engine method. -->
    <ProjectReference Include="../WhatYouCarry.Game/WhatYouCarry.Game.csproj" />
    <ProjectReference Include="../WhatYouCarry.Tools/WhatYouCarry.Tools.csproj" />
  </ItemGroup>
</Project>
