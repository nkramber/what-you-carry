<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tool project (D-65). Each tool is one command of this executable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The C# compiler API, for the det-lint parse (D-202). A parse tells an identifier from a comment. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The asset-qa command reads the models and the animations through the Assets project (D-299). -->
    <ProjectReference Include="../WhatYouCarry.Assets/WhatYouCarry.Assets.csproj" />
    <!-- The bit-identity command runs the Core determinism types (D-201). Core references nothing back (G-1). -->
    <ProjectReference Include="../WhatYouCarry.Core/WhatYouCarry.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The bit-identity sweep folds runs on the content of the checkout (F-133). The build puts every JSON file that
         Core reads into the tool, so the sweep takes no option and opens no file. The models, the textures, and the
         audio stay out, because Core never reads them (D-298, D-305, D-453). -->
    <EmbeddedResource Include="../content/**/*.json" Exclude="../content/models/**;../content/textures/**;../content/audio/**" LogicalName="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
